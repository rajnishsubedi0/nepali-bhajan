<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/bg_list_item"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Scrollable content zone or container for Header & Navigation Links -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Part with Brand Icon and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- App Icon (Shiva Colorized) -->
            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/shiva_colorized"
                android:tint="@color/shiva_icon_tint"
                android:layout_marginEnd="16dp"
                android:contentDescription="App Logo Icon" />

            <!-- Title content -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="भजन संग्रह"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bhajan Sangraha"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.02" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#15808080"
            android:layout_marginBottom="24dp" />

        <!-- NEW: Audio Stream Navigation Button -->
        <LinearLayout
            android:id="@+id/nav_audio_stream"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_audio_stream"
                android:tint="@color/accent_icon"
                android:layout_marginEnd="16dp"
                android:contentDescription="Audio Stream Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio Stream"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom creator card section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_gravity="bottom">

        <!-- Outer elegant card for Creator/About Me -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center">


            <!-- Quote Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Made with "
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="serif-monospace"
                    android:textStyle="italic" />

                <!-- Heart Image containing pulse animation -->
                <ImageView
                    android:id="@+id/img_heart_beat"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_heart"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Heart Symbol" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ~ Rajnish"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="serif-monospace"
                    android:textStyle="bold|italic" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
