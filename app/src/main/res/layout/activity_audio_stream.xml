<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true"
    tools:context=".AudioStreamActivity">

    <!-- Custom Top App Bar -->
    <FrameLayout
        android:id="@+id/app_bar_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_list_item"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btn_back_audio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_back_arrow"
                android:tint="@color/text_primary"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btn_back_audio"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Live Audio Stream"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Player Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Stream Artwork / App Icon -->
        <ImageView
            android:id="@+id/img_stream_art"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/shiva_colorized"
            android:layout_marginBottom="32dp"
            android:contentDescription="Stream Art" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="भजन संग्रह"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_stream_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Bhajan Stream"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="48dp"/>

        <!-- Play/Pause Button Container -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:padding="18dp"
                android:background="@drawable/bg_circle_youtube"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/bg_app"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Play/Pause" />

            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:visibility="gone"
                android:indeterminateTint="@color/accent_icon"
                android:layout_gravity="center"/>
        </FrameLayout>

    </LinearLayout>
</LinearLayout>