<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keep Music Playing"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_battery_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Battery optimization is currently ON for this app"
        android:textColor="@color/red"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Android may stop your bhajans when the screen turns off or the app moves to the background. To keep audio playing, please turn off battery optimization for this app."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_device_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_enable"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_accent"
        android:gravity="center"
        android:text="Disable Battery Optimization"
        android:textColor="@color/on_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_device_settings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:text="Open Device Settings"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_later"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Not Now"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>